# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=your_openai_api_key_here

# KoAlpaca (Modal serverless, NF4 + LoRA attach, A10G 24GB)
# 배포: modal deploy ai-model/nf4_modal.py
# URL은 Modal 대시보드 또는 deploy 출력에서 확인
KOALPACA_ENDPOINT_URL=https://<workspace>--koalpaca-nf4-inference-summarize.modal.run
KOALPACA_API_KEY=your-random-api-key-here  # Modal secret koalpaca-secret의 KOALPACA_API_KEY 값과 일치

# KlueBERT (Hugging Face Spaces, public Space) — X-API-Key 헤더 인증
# Space Secret HF_SPACE_API_KEY 값과 반드시 동일해야 함
KLUEBERT_ENDPOINT_URL=https://yun-choice-kluebert-counshelper.hf.space
KLUEBERT_API_KEY=your-shared-secret-here
