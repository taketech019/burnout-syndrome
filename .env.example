# Backend selection
# 실제 운영: koalpaca_api / gemini_api / kluebert_api
# 로컬 테스트 or 엔드포인트 미배포: mock
MODEL_BACKEND=koalpaca_api
FACTOR_BACKEND=gemini_api
CLASSIFIER_BACKEND=kluebert_api

# KoAlpaca API (Modal)
# 실제 값은 Streamlit Secrets 또는 로컬 .env에만 입력 — GitHub 커밋 금지
KOALPACA_ENDPOINT_URL=
KOALPACA_API_KEY=

# Gemini API (28요인 라벨링 + RAG 챗봇)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# KlueBERT API (HuggingFace Space)
KLUEBERT_ENDPOINT_URL=
KLUEBERT_API_KEY=

# RAG / ChromaDB
CHROMA_DB_PATH=./chroma_db
RAG_EMBEDDING_MODEL=snunlp/KR-SBERT-V40K-klueNLI-augSTS

# Streamlit Cloud Secrets 설정 예시 (secrets.toml 형식):
# MODEL_BACKEND = "koalpaca_api"
# FACTOR_BACKEND = "gemini_api"
# CLASSIFIER_BACKEND = "kluebert_api"
# GEMINI_API_KEY = "..."
# KOALPACA_ENDPOINT_URL = "..."
# KOALPACA_API_KEY = "..."
# KLUEBERT_ENDPOINT_URL = "..."
# KLUEBERT_API_KEY = "..."
# CHROMA_DB_PATH = "./chroma_db"
# RAG_EMBEDDING_MODEL = "snunlp/KR-SBERT-V40K-klueNLI-augSTS"
