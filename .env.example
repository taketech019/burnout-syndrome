DEMO_MODE=true

# Backend selection
MODEL_BACKEND=mock
FACTOR_BACKEND=mock
CLASSIFIER_BACKEND=mock

# KoAlpaca API
# 실제 값은 GitHub에 올리지 말고 Streamlit Secrets 또는 로컬 .streamlit/secrets.toml에 입력
KOALPACA_ENDPOINT_URL=
KOALPACA_API_KEY=

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# KlueBERT Hugging Face model repos
# private repo를 사용할 경우 HF_TOKEN 필요
HF_TOKEN=
KLUEBERT_DEPRESSION_MODEL=
KLUEBERT_ANXIETY_MODEL=
KLUEBERT_ADDICTION_MODEL=

# Optional KlueBERT API endpoint
# 팀원이 제공한 HF Space/API 방식으로 전환할 경우 사용
KLUEBERT_ENDPOINT_URL=
KLUEBERT_API_KEY=

# RAG / ChromaDB
CHROMA_DB_PATH=./chroma_db
RAG_EMBEDDING_MODEL=snunlp/KR-SBERT-V40K-klueNLI-augSTS
